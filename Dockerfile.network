FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends dbus iproute2 iptables iputils-ping systemd \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY network-collector/package.json ./package.json
COPY network-collector/src ./src

USER root
CMD ["node", "src/server.js"]
